# Required by the native ChatOpenAI quickstart and every live LLM-backed command.
DEEPSEEK_API_KEY=

# Required only by `glodex agent-api serve --live` when web_search is enabled.
TAVILY_API_KEY=

# Required only by `glodex agent-api serve --live` for encrypted LangGraph checkpoints.
# Use exactly 16, 24, or 32 ASCII characters and keep the value private.
LANGGRAPH_AES_KEY=
